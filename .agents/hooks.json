{
  "ict-deny-destructive": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/deny-destructive.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "ict-rustfmt-on-edit": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/rustfmt-on-edit.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "ict-stop-check": {
    "Stop": [
      {
        "type": "command",
        "command": "bash .agents/hooks/stop-check.sh",
        "timeout": 300
      }
    ]
  }
}
